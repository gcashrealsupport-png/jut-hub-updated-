local rfConnections = {}
local function ApplyToTool(tool)
    if not tool:IsA("Tool") then return end
    if Config.RapidFire then
        tool:SetAttribute("RateOfFire", 100000)
        tool:SetAttribute("rateOfFire", 100000)
    else
        tool:SetAttribute("RateOfFire", nil)
        tool:SetAttribute("rateOfFire", nil)
