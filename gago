local function StartTPCam()
    local cam = Workspace.CurrentCamera
    tpCamRotation = cam.CFrame - cam.CFrame.Position
    cam.CameraType = Enum.CameraType.Scriptable
    Config.CameraActive = true
    mobileCtrl.Visible = true
    tpCamBtn.BackgroundColor3 = Color3.fromRGB(40, 150, 80) -- Green
    tpCamBtn.Text = "CLICK HERE TO TP"
    
    if tpCamConn then tpCamConn:Disconnect() end
    tpCamConn = RunService.RenderStepped:Connect(function(dt)
        if not Config.CameraActive then return end
        local c = Workspace.CurrentCamera
        if c.CameraType ~= Enum.CameraType.Scriptable then c.CameraType = Enum.CameraType.Scriptable end
        
        local move = Vector3.new(0,0,0)
        if moveVec.Magnitude > 0.1 then 
            move += tpCamRotation.LookVector * moveVec.Y
            move += tpCamRotation.RightVector * moveVec.X 
        end
        if _up then move += Vector3.new(0,1,0) end
        if _down then move -= Vector3.new(0,1,0) end
        
        if move.Magnitude > 0 then 
            c.CFrame = CFrame.new(c.CFrame.Position + move.Unit * 140 * dt) * tpCamRotation 
        else 
            c.CFrame = CFrame.new(c.CFrame.Position) * tpCamRotation 
        end
    end)
end

local function StopTPCam()
    Config.CameraActive = false
    mobileCtrl.Visible = false
    tpCamBtn.BackgroundColor3 = Color3.fromRGB(155, 90, 255) -- Purple
    tpCamBtn.Text = "TP CAM"
