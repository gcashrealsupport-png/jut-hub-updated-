local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    if not checkcaller() and Config.SilentAim and SilentTarget then
        if method == "Raycast" then
            local args = {...}
            if typeof(args[2]) == "Vector3" and args[2].Magnitude > 25 then
                args[2] = (SilentTarget.Position - args[1]).Unit * args[2].Magnitude
                return oldNamecall(self, unpack(args))
            end
        elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" then
            local args = {...}
            if typeof(args[1]) == "Ray" and args[1].Direction.Magnitude > 25 then
                args[1] = Ray.new(args[1].Origin, (SilentTarget.Position - args[1].Origin).Unit * args[1].Direction.Magnitude)
                return oldNamecall(self, unpack(args))
            end
        elseif method == "FireServer" or method == "InvokeServer" then
            local args = {...}
            for i, v in pairs(args) do
                if typeof(v) == "CFrame" and v.Position.Magnitude > 1 then
                    args[i] = CFrame.lookAt(v.Position, SilentTarget.Position)
                end
            end
            return oldNamecall(self, unpack(args))
        end
    end
    return oldNamecall(self, ...)
end)
