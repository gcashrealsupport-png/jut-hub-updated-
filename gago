local function WatchContainer(container)
    if not container then return end
    for _, item in ipairs(container:GetChildren()) do ApplyToTool(item) end
    local conn = container.ChildAdded:Connect(ApplyToTool)
    table.insert(rfConnections, conn)
end

local function SetupRapidFire(character)
    for _, conn in ipairs(rfConnections) do conn:Disconnect() end
    table.clear(rfConnections)
    WatchContainer(character)
    WatchContainer(LocalPlayer:WaitForChild("Backpack"))
end

