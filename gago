-- 4. TEAM CHECK (Strict)
local function IsTeammate(TargetPlayer)
    if not TargetPlayer or TargetPlayer == LocalPlayer then return true end
    local LC = LocalPlayer.Character
    local TC = TargetPlayer.Character
    if LC and TC then
        local LM, TM = LC:GetAttribute("MatchId"), TC:GetAttribute("MatchId")
        if LM ~= nil or TM ~= nil then
            local LT, TT = LC:GetAttribute("PvPTeam"), TC:GetAttribute("PvPTeam")
            return LM ~= nil and LM == TM and LT ~= nil and TT ~= nil and LT == TT
        end
    end
    local LS, TS = LocalPlayer:GetAttribute("StageTeamSide"), TargetPlayer:GetAttribute("StageTeamSide")
    if typeof(LS) == "number" and typeof(TS) == "number" then return LS == TS end
    if LocalPlayer.Neutral or TargetPlayer.Neutral then return false end
    return LocalPlayer.Team ~= nil and TargetPlayer.Team == LocalPlayer.Team
end

-- 5. WALL CHECK FUNCTION
local function IsVisible(targetPart)
    if not targetPart then return false end
    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = { LocalPlayer.Character, targetPart.Parent }
    rayParams.IgnoreWater = true
    local result = Workspace:Raycast(origin, direction, rayParams)
    return result == nil
end

-- 6. TARGETING LOGIC
local function GetTarget()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local bestPart, bestScore = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not IsTeammate(p) and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local head = p.Character:FindFirstChild("Head")
            if hum and hum.Health > 0 and head and not p.Character:FindFirstChildOfClass("ForceField") then
                if Config.WallCheck and not IsVisible(head) then continue end
                local scr, on = Camera:WorldToViewportPoint(head.Position)
                if on and scr.Z > 0 then
                    local dSq = (scr.X-center.X)^2 + (scr.Y-center.Y)^2
                    if dSq <= Config.FovSize^2 and dSq < bestScore then
                        bestScore = dSq; bestPart = head
                    end
                end
            end
        end
    end
    return bestPart
end

