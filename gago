-- 12. HITBOX LOGIC
local originalHitboxSizes = {}
local function ResetHitboxes()
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= LocalPlayer and other.Character then
            local hrp = other.Character:FindFirstChild("HumanoidRootPart")
            if hrp and originalHitboxSizes[other] then
                hrp.Size = originalHitboxSizes[other].size
                hrp.Transparency = originalHitboxSizes[other].transparency
                hrp.CanCollide = originalHitboxSizes[other].canCollide
                originalHitboxSizes[other] = nil
            end
        end
    end
end

function UpdateHitboxes()
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= LocalPlayer and other.Character then
            local hrp = other.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                if Config.Hitbox then
                    if not originalHitboxSizes[other] then
                        originalHitboxSizes[other] = { size = hrp.Size, transparency = hrp.Transparency, canCollide = hrp.CanCollide }
                    end
                    local s = Config.HitboxSize
                    hrp.Size = Vector3.new(s, s, s)
                    hrp.Transparency = 0.7
                    hrp.CanCollide = false
                elseif originalHitboxSizes[other] then
                    hrp.Size = originalHitboxSizes[other].size
                    hrp.Transparency = originalHitboxSizes[other].transparency
                    hrp.CanCollide = originalHitboxSizes[other].canCollide
                    originalHitboxSizes[other] = nil
                end
            end
        end
    end
end

