-- 4. TEAM CHECK (Strict)
local function IsTeammate(TargetPlayer)
    if not TargetPlayer or TargetPlayer == LocalPlayer then return true end
    local LC = LocalPlayer.Character
    local TC = TargetPlayer.Character
    if LC and TC then
        local LM, TM = LC:GetAttribute("MatchId"), TC:GetAttribute("MatchId")
        if LM ~= nil or TM ~= nil then
            local LT, TT = LC:GetAttribute("PvPTeam"), TC:GetAttribute("PvPTeam")
            return LM ~= nil and LM == TM and LT ~= nil and TT ~= nil and LT == TT
        end
    end
    local LS, TS = LocalPlayer:GetAttribute("StageTeamSide"), TargetPlayer:GetAttribute("StageTeamSide")
    if typeof(LS) == "number" and typeof(TS) == "number" then return LS == TS end
    if LocalPlayer.Neutral or TargetPlayer.Neutral then return false end
    return LocalPlayer.Team ~= nil and TargetPlayer.Team == LocalPlayer.Team
end

-- 5. WALL CHECK FUNCTION
local function IsVisible(targetPart)
    if not targetPart then return false end
    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = { LocalPlayer.Character, targetPart.Parent }
    rayParams.IgnoreWater = true
    local result = Workspace:Raycast(origin, direction, rayParams)
    return result == nil
end

-- 6. TARGETING LOGIC (May Wall Check)
local function GetTarget()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local bestPart, bestScore = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not IsTeammate(p) and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local head = p.Character:FindFirstChild("Head")
            if hum and hum.Health > 0 and head and not p.Character:FindFirstChildOfClass("ForceField") then
                if Config.WallCheck and not IsVisible(head) then continue end
                local scr, on = Camera:WorldToViewportPoint(head.Position)
                if on and scr.Z > 0 then
                    local dSq = (scr.X-center.X)^2 + (scr.Y-center.Y)^2
                    if dSq <= Config.FovSize^2 and dSq < bestScore then
                        bestScore = dSq; bestPart = head
                    end
                end
            end
        end
    end
    return bestPart
end

-- 7. SILENT AIM
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    if not checkcaller() and Config.SilentAim and SilentTarget then
        if method == "Raycast" then
            local args = {...}
            if typeof(args[2]) == "Vector3" and args[2].Magnitude > 25 then
                args[2] = (SilentTarget.Position - args[1]).Unit * args[2].Magnitude
                return oldNamecall(self, unpack(args))
            end
        elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" then
            local args = {...}
            if typeof(args[1]) == "Ray" and args[1].Direction.Magnitude > 25 then
                args[1] = Ray.new(args[1].Origin, (SilentTarget.Position - args[1].Origin).Unit * args[1].Direction.Magnitude)
                return oldNamecall(self, unpack(args))
            end
        elseif method == "FireServer" or method == "InvokeServer" then
            local args = {...}
            for i, v in pairs(args) do
                if typeof(v) == "CFrame" and v.Position.Magnitude > 1 then
                    args[i] = CFrame.lookAt(v.Position, SilentTarget.Position)
                end
            end
            return oldNamecall(self, unpack(args))
        end
    end
    return oldNamecall(self, ...)
end)

-- 8. RENDER LOOP (Aim Assist, 100% Aimbot, Max Cam Lock, TP Cam)
RunService.RenderStepped:Connect(function()
    if Config.SilentAim then SilentTarget = GetTarget() else SilentTarget = nil end
    local targetPart = GetTarget()
    
    if targetPart then
        if Config.AimAssist then
            local smoothFactor = math.clamp(1 / Config.AimAssistSmooth, 0.01, 1)
            local newCFrame = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
            Camera.CFrame = Camera.CFrame:Lerp(newCFrame, smoothFactor)
        end
        if Config.Aimbot100 then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
        end
        if Config.MaxCamLock then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
        end
        if Config.TPCam then
            Camera.CFrame = targetPart.CFrame * CFrame.new(0, 5, 10)
        end
    end
end)
