-- 10. CHAMS ESP (Solid Glow)
local function UpdateChams()
    if not Config.Chams then
        for _, hl in pairs(PlayerChams) do
            if hl and hl.Parent then hl:Destroy() end
        end
        table.clear(PlayerChams)
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and not IsTeammate(plr) and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                if not PlayerChams[plr] or not PlayerChams[plr].Parent then
                    local hl = Instance.new("Highlight")
                    hl.Name = "TheooChams"
                    hl.FillColor = Color3.fromRGB(255, 60, 90)
                    hl.FillTransparency = 0.4
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.OutlineTransparency = 0
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Adornee = plr.Character
                    hl.Parent = plr.Character
                    PlayerChams[plr] = hl
                else
                    PlayerChams[plr].Adornee = plr.Character
                end
            elseif PlayerChams[plr] then
                PlayerChams[plr]:Destroy()
                PlayerChams[plr] = nil
            end
        elseif PlayerChams[plr] then
            PlayerChams[plr]:Destroy()
            PlayerChams[plr] = nil
        end
    end
end

